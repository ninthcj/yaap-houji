From bc3eaa5f23c8e9acca1b6e67e12a17b8a0f3540f Mon Sep 17 00:00:00 2001
From: ninthcj <327845320+ninthcj@users.noreply.github.com>
Date: Wed, 25 Nov 2026 13:51:38 -0400
Subject: [PATCH 10/10] houji: enable real-time Gaussian blur and 10W Wireless
 PowerShare

---
 device.mk     | 5 +++++
 yaap_houji.mk | 3 +++
 2 files changed, 8 insertions(+)

diff --git a/device.mk b/device.mk
index b72d59a..226bce0 100644
--- a/device.mk
+++ b/device.mk
@@ -14,6 +14,11 @@ $(call inherit-product, vendor/xiaomi/houji/houji-vendor.mk)
 # Vibrator: only expose primitives backed by device waveform files.
 $(call soong_config_set,qti_vibrator,effect_lib,//device/xiaomi/houji:libqtivibratoreffect.houji)
 
+# Wireless PowerShare (10W reverse wireless charging)
+$(call soong_config_set,lineage_powershare,powershare_path,/sys/class/qcom-battery/reverse_chg_mode)
+PRODUCT_PACKAGES += \
+    vendor.lineage.powershare-service.default
+
 # eSIM: use YAAP's open-source LPA instead of a Google prebuilt.
 PRODUCT_PACKAGES += \
     OpenEUICC \
diff --git a/yaap_houji.mk b/yaap_houji.mk
index a6be470..165c5ea 100644
--- a/yaap_houji.mk
+++ b/yaap_houji.mk
@@ -11,6 +11,9 @@ $(call inherit-product, $(SRC_TARGET_DIR)/product/full_base_telephony.mk)
 # Inherit from houji device
 $(call inherit-product, device/xiaomi/houji/device.mk)
 
+# Enable real-time SurfaceFlinger & Launcher Gaussian blur on Adreno 750
+TARGET_ENABLE_BLUR := true
+
 # Inherit some common YAAP stuff.
 $(call inherit-product, vendor/yaap/config/common_full_phone.mk)
 
-- 
