From 18c5fcf5d24f12b6ef5b3a4a15ed6e572f98067d Mon Sep 17 00:00:00 2001
From: ninthcj <327845320+ninthcj@users.noreply.github.com>
Date: Mon, 23 Nov 2026 18:01:47 -0400
Subject: [PATCH 07/10] houji: restore OTA alias, eUICC overlay and CN init

- Assert houji,houjiin and accept houjiin in board-info
- Restore HoujiEuiccOverlay and init.houji.rc (CN masks the Global eUICC overlay)
- Use the neutral Xiaomi 14 model; keep OpenEUICC and XiaomiEsimSwitcher
- Stop generating firmware registrations; radio sources retained for reference
---
 BoardConfig.mk                                |  5 ++--
 board-info.txt                                |  2 +-
 device.mk                                     |  5 ++++
 docs/dev/bringup.md                           |  2 +-
 docs/dev/radio-firmware.md                    |  8 +++---
 extract-files.py                              |  2 +-
 init/init.houji.rc                            |  8 ++++++
 overlays/HoujiEuiccOverlay/Android.bp         | 10 +++++++
 .../HoujiEuiccOverlay/AndroidManifest.xml     | 16 +++++++++++
 .../HoujiEuiccOverlay/res/values/arrays.xml   | 24 ++++++++++++++++
 .../HoujiEuiccOverlay/res/values/config.xml   | 28 +++++++++++++++++++
 yaap_houji.mk                                 |  2 +-
 12 files changed, 101 insertions(+), 11 deletions(-)
 create mode 100644 init/init.houji.rc
 create mode 100644 overlays/HoujiEuiccOverlay/Android.bp
 create mode 100644 overlays/HoujiEuiccOverlay/AndroidManifest.xml
 create mode 100644 overlays/HoujiEuiccOverlay/res/values/arrays.xml
 create mode 100644 overlays/HoujiEuiccOverlay/res/values/config.xml

diff --git a/BoardConfig.mk b/BoardConfig.mk
index 8438441..c0e83c8 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -20,9 +20,8 @@ else
 include $(DEVICE_PATH)/configs/kernel/prebuilt.mk
 endif
 
-# Assert: the CN 23127PN0CC bring-up baseline reports ro.product.device=houji; the India SKU
-# alias (houjiin, which libinit normalizes to houji) is not part of this release.
-TARGET_OTA_ASSERT_DEVICE := houji
+# OTA: the India SKU reports ro.product.device=houjiin before libinit normalizes it.
+TARGET_OTA_ASSERT_DEVICE := houji,houjiin
 
 # Properties
 TARGET_ODM_PROP += $(DEVICE_PATH)/configs/properties/odm.prop
diff --git a/board-info.txt b/board-info.txt
index d1250ee..e3cf537 100644
--- a/board-info.txt
+++ b/board-info.txt
@@ -1 +1 @@
-require board=houji|pineapple
+require board=houji|houjiin|pineapple
diff --git a/device.mk b/device.mk
index 3dd01f0..b72d59a 100644
--- a/device.mk
+++ b/device.mk
@@ -19,6 +19,10 @@ PRODUCT_PACKAGES += \
     OpenEUICC \
     XiaomiEsimSwitcher
 
+# Init: the CN variant masks the Global-only eUICC overlay.
+PRODUCT_COPY_FILES += \
+    $(LOCAL_PATH)/init/init.houji.rc:$(TARGET_COPY_OUT_VENDOR)/etc/init/init.houji.rc
+
 # Soong namespaces
 PRODUCT_SOONG_NAMESPACES += \
     $(LOCAL_PATH)
@@ -27,6 +31,7 @@ PRODUCT_SOONG_NAMESPACES += \
 PRODUCT_PACKAGES += \
     ApertureOverlayHouji \
     FrameworksResHouji \
+    HoujiEuiccOverlay \
     SettingsOverlayHouji \
     SystemUIResHouji
 
diff --git a/docs/dev/bringup.md b/docs/dev/bringup.md
index d20f5de..d81747b 100644
--- a/docs/dev/bringup.md
+++ b/docs/dev/bringup.md
@@ -95,7 +95,7 @@ python3 tools/extract-utils/extract.py --keep-images \
 python3 device/xiaomi/houji/extract-files.py --kang /path/to/rom/images
 ```
 
-脚本会处理 houji 和 common 两个模块；固件清单包含 Fastboot 原文件名到分区镜像名的映射。
+脚本会处理 houji 和 common 两个模块；固件清单只作为来源记录，不注册构建或 A/B OTA 分区。
 除退出码外，应检查提取日志没有 `file not found`、`Some files failed` 或 traceback，
 并确认生成两个 vendor makefile。更新时同步提取 vendor_boot 的模块加载元数据。
 
diff --git a/docs/dev/radio-firmware.md b/docs/dev/radio-firmware.md
index f9b5af7..754d611 100644
--- a/docs/dev/radio-firmware.md
+++ b/docs/dev/radio-firmware.md
@@ -17,10 +17,10 @@
 | NON-HLOS.bin | radio/modem.img | 3ccb918129b84228c6e3454969a83ba24f6df5e72ca10488e9044a0d11c21d8b |
 | MODEM-FW.bin | radio/modemfirmware.img | 66dcc89d63d047a8d0a1f70139c09f7378d82387e21d83fa062636447b5315fa |
 
-`proprietary-firmware.txt` 的两个 SHA-1 pin 与 vendor `Android.mk` 保持一致，
-以便后续 OTA 继续打包这对固件。先完整拉取 vendor Git LFS 对象，再执行
-正常提取，extract-utils 会保留匹配 pin 的文件。不要对国际版包执行不加
-区分的 `--kang` 并覆盖这两个 pin；重新生成文件时检查这两项来源与摘要。
+`proprietary-firmware.txt` 保留这两个 SHA-1 pin 作为来源记录；`extract-files.py`
+不再生成固件 `Android.mk`/`AB_OTA_PARTITIONS`，ROM 与 OTA 包不携带任何 radio
+固件分区，需要时由操作者按下文单独刷写。先完整拉取 vendor Git LFS 对象，再执行
+正常提取。不要对国际版包执行不加区分的 `--kang` 并覆盖这两个 pin。
 本选择针对国行测试机，国际版实体机需要重新核定地区基带。
 
 ## 安装和验证
