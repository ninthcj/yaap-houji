From 8f5b5070b6c246522cee8d52746ca597c59ff9d6 Mon Sep 17 00:00:00 2001
From: ninthcj <327845320+ninthcj@users.noreply.github.com>
Date: Mon, 23 Nov 2026 16:37:45 -0400
Subject: [PATCH 1/2] build: use Bionic scheduler types in exported kernel
 headers

Avoid a duplicate sched_param declaration from raw GKI headers and declare the sanitizer inputs in the generator.
---
 build/soong/Android.bp | 18 +++++++++++++-----
 tools/clean_headers.sh |  4 ++--
 2 files changed, 15 insertions(+), 7 deletions(-)

diff --git a/build/soong/Android.bp b/build/soong/Android.bp
index 7a312e4..7c810f4 100644
--- a/build/soong/Android.bp
+++ b/build/soong/Android.bp
@@ -35,12 +35,14 @@ yaap_generator {
     ],
 
     // Sources for dependency tracking
-    dep_root: "$(TARGET_KERNEL_SOURCE)",
+    dep_root: ".",
     dep_files: [
-        "Makefile",
-        "include/**/*",
-        "arch/$(KERNEL_ARCH)/include/**/*",
-        "techpack/audio/include/**/*",
+        "$(TARGET_KERNEL_SOURCE)/Makefile",
+        "$(TARGET_KERNEL_SOURCE)/include/**/*",
+        "$(TARGET_KERNEL_SOURCE)/arch/$(KERNEL_ARCH)/include/**/*",
+        "$(TARGET_KERNEL_SOURCE)/techpack/audio/include/**/*",
+        "vendor/yaap/tools/clean_headers.sh",
+        "bionic/libc/kernel/uapi/linux/sched/types.h",
     ],
 }
 
@@ -60,6 +62,12 @@ yaap_generator {
         "usr/include/audio/include/uapi",
         "usr/techpack/audio/include",
     ],
+
+    dep_root: ".",
+    dep_files: [
+        "vendor/yaap/tools/clean_headers.sh",
+        "bionic/libc/kernel/uapi/linux/sched/types.h",
+    ],
 }
 
 bootstrap_go_package {
diff --git a/tools/clean_headers.sh b/tools/clean_headers.sh
index f3c47e9..bd94538 100755
--- a/tools/clean_headers.sh
+++ b/tools/clean_headers.sh
@@ -6,5 +6,5 @@ export ANDROID_BUILD_TOP="$PWD"
 ./bionic/libc/kernel/tools/clean_header.py -u \
     "$1/usr/include/asm-generic/signal.h"
 
-./bionic/libc/kernel/tools/clean_header.py -u \
-    "$1/usr/include/linux/sched/types.h"
+# Bionic's <sched.h> owns the POSIX sched_param declaration.
+cp bionic/libc/kernel/uapi/linux/sched/types.h "$1/usr/include/linux/sched/types.h"
