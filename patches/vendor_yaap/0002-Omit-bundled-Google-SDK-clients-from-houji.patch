From 9ab89e01ef7ca63976f006f6db09db048f992017 Mon Sep 17 00:00:00 2001
From: ninthcj <327845320+ninthcj@users.noreply.github.com>
Date: Mon, 23 Nov 2026 17:41:57 -0400
Subject: [PATCH 2/2] Omit bundled Google SDK clients from houji

- Exclude the Play-distributed YASR build and the TalkBack prebuilt carrying Play Services for Wear.
---
 config/packages.mk | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/config/packages.mk b/config/packages.mk
index 32cacbd..b0729fd 100644
--- a/config/packages.mk
+++ b/config/packages.mk
@@ -42,13 +42,17 @@ PRODUCT_PACKAGES += \
     Glimpse \
     MatLog \
     Twelve \
-    YASR \
     Seedvault \
     OmniJaws \
     OpenDelta \
     Ripple \
     Panic
 
+# The bundled recorder is Play-signed and embeds Play Services and Firebase.
+ifneq ($(TARGET_PRODUCT),yaap_houji)
+PRODUCT_PACKAGES += YASR
+endif
+
 # TextClassifier
 PRODUCT_PACKAGES += \
     libtextclassifier_annotator_en_model \
@@ -88,10 +92,12 @@ PRODUCT_PACKAGES += \
     LatinIME \
     messaging \
     SetupWizard \
-    Talkback \
     TrichromeChromeDualArch \
     TrichromeLibraryDualArch \
     TrichromeWebViewDualArch
+ifneq ($(TARGET_PRODUCT),yaap_houji)
+PRODUCT_PACKAGES += Talkback
+endif
 endif
 
 # Include explicitly to work around GMS issues
