diff --git a/BoardConfigVendor.mk b/BoardConfigVendor.mk
index 0b66c8d..244cfb3 100644
--- a/BoardConfigVendor.mk
+++ b/BoardConfigVendor.mk
@@ -2,25 +2,6 @@
 # Automatically generated file. DO NOT MODIFY
 #
 
-AB_OTA_PARTITIONS += \
-    abl \
-    aop \
-    aop_config \
-    bluetooth \
-    cpucp \
-    devcfg \
-    dsp \
-    featenabler \
-    hyp \
-    imagefv \
-    keymaster \
-    modem \
-    modemfirmware \
-    qupfw \
-    shrm \
-    tz \
-    uefi \
-    uefisecapp \
-    xbl \
-    xbl_config \
-    xbl_ramdump
+# Images under radio/ are retained as source assets only. They are not
+# registered with add-radio-file-sha1-checked or AB_OTA_PARTITIONS, so the
+# OTA package carries no radio/firmware partitions.
diff --git a/README.md b/README.md
index aa5e149..754701a 100644
--- a/README.md
+++ b/README.md
@@ -9,7 +9,8 @@ Both userspace vendor trees use this same ROM, including IMS; no older IMS or Pi
 The modem firmware exception for the CN test device is recorded below.
 Vendor security patch: `2026-10-01`. Runtime compatibility still needs build and device validation.
 
-Firmware images under `radio/` use Git LFS. Install Git LFS before cloning or syncing.
+Firmware images under `radio/` use Git LFS and are retained as source assets only:
+they are not registered in the build (`Android.mk`) or in `AB_OTA_PARTITIONS`.
 
 ## Stock kernel bundle
 
