+
+cc_library_static {
+    name: "power-ext-xiaomi-sm8650",
+    defaults: ["android.hardware.power-ndk_shared"],
+    vendor: true,
+    srcs: ["power-mode.cpp"],
+    shared_libs: ["libbase"],
+}
