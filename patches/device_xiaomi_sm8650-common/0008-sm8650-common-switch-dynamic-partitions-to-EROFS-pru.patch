diff --git a/rootdir/etc/init.xiaomi.rc b/rootdir/etc/init.xiaomi.rc
index f1cf2c3..ed6e56f 100644
--- a/rootdir/etc/init.xiaomi.rc
+++ b/rootdir/etc/init.xiaomi.rc
@@ -3,6 +3,16 @@ on early-boot
     chmod 0664 /sys/bus/platform/devices/soc:xiaomi_fingerprint/fingerdown
 
 on boot
+    # Xiaomi PMIC PowerShare, hardware bypass charging, and battery SOH
+    chown system system /sys/class/qcom-battery/reverse_chg_mode
+    chmod 0664 /sys/class/qcom-battery/reverse_chg_mode
+    chown system system /sys/class/qcom-battery/night_charging
+    chmod 0664 /sys/class/qcom-battery/night_charging
+    chown system system /sys/class/qcom-battery/ui_soh
+    chmod 0444 /sys/class/qcom-battery/ui_soh
+    chown system system /sys/class/qcom-battery/soh
+    chmod 0444 /sys/class/qcom-battery/soh
+
     # Xiaomi touch
     chown system system /dev/xiaomi-touch
     chmod 0660 /dev/xiaomi-touch
@@ -62,6 +72,15 @@ on property:vendor.post_boot.parsed=1
     # Set default thermal profile
     write /sys/class/thermal/thermal_message/sconfig 0
 
+# Mask orphaned HyperOS touch-telemetry oneshot declared in odm touchfeature rc
+service toucheventcheck /system/bin/true
+    override
+    class main
+    user system
+    group system
+    disabled
+    oneshot
+
 service vendor.audio-hal /vendor/bin/hw/android.hardware.audio.service
     override
     class hal
