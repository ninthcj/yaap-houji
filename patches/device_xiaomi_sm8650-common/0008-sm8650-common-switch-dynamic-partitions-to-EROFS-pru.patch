diff --git a/common.mk b/common.mk
index f852f9d..efa64d9 100644
--- a/common.mk
+++ b/common.mk
@@ -5,12 +5,51 @@
 #
 
 # Override stock atfwd seccomp policy lacking bionic lseek allowance
-# (must precede inherit-product so first PRODUCT_COPY_FILES entry wins)
+# (must precede vendor include so first PRODUCT_COPY_FILES entry wins)
 PRODUCT_COPY_FILES += \
     device/xiaomi/sm8650-common/configs/seccomp/atfwd@2.0.policy:$(TARGET_COPY_OUT_VENDOR)/etc/seccomp_policy/atfwd@2.0.policy
 
-# Call the proprietary setup.
-$(call inherit-product, vendor/xiaomi/sm8650-common/sm8650-common-vendor.mk)
+# Include proprietary setup synchronously so unused HyperOS/payment/SLA daemons can be pruned cleanly.
+include vendor/xiaomi/sm8650-common/sm8650-common-vendor.mk
+
+# Prune orphaned proprietary payment/attestation, SLA, and touch-telemetry daemons with zero AOSP consumers.
+# Retain vendor.xiaomi.hardware.aidl.mtdservice-V1-ndk_platform for libGPQeSE.so ELF DT_NEEDED linkage.
+PRODUCT_PACKAGES := $(filter-out \
+    eid-default.xml \
+    fidoca \
+    libmfido \
+    libmlipay \
+    libmt \
+    libtida \
+    manifest_vendor.xiaomi.hardware.aidl.mtdservice.xml \
+    manifest_vendor.xiaomi.hardware.aidl.tidaservice.xml \
+    manifest_vendor.xiaomi.hardware.mfidoca.xml \
+    manifest_vendor.xiaomi.hardware.mlipay.xml \
+    mlipayd \
+    mtd \
+    slad \
+    tidad \
+    toucheventcheck \
+    vendor.qti.sla.service@1.0 \
+    vendor.qti.sla.service@1.0-impl \
+    vendor.qti.sla.service@1.0-service \
+    vendor.rongcard.eid-V1-ndk_platform \
+    vendor.rongcard.eid@1.0-service \
+    vendor.xiaomi.hardware.aidl.tidaservice-V1-ndk_platform \
+    vendor.xiaomi.hardware.mfidoca-V1-ndk_platform \
+    vendor.xiaomi.hardware.mlipay-V1-ndk_platform \
+    ,$(PRODUCT_PACKAGES))
+
+PRODUCT_COPY_FILES := $(filter-out \
+    vendor/xiaomi/sm8650-common/proprietary/odm/etc/init/vendor.xiaomi.hardware.aidl.mtdservice-service.rc:$(TARGET_COPY_OUT_ODM)/etc/init/vendor.xiaomi.hardware.aidl.mtdservice-service.rc \
+    vendor/xiaomi/sm8650-common/proprietary/odm/etc/init/vendor.xiaomi.hardware.aidl.tidaservice-service.rc:$(TARGET_COPY_OUT_ODM)/etc/init/vendor.xiaomi.hardware.aidl.tidaservice-service.rc \
+    vendor/xiaomi/sm8650-common/proprietary/odm/etc/init/vendor.xiaomi.hardware.mfidoca-service.rc:$(TARGET_COPY_OUT_ODM)/etc/init/vendor.xiaomi.hardware.mfidoca-service.rc \
+    vendor/xiaomi/sm8650-common/proprietary/odm/etc/init/vendor.xiaomi.hardware.mlipay-service.rc:$(TARGET_COPY_OUT_ODM)/etc/init/vendor.xiaomi.hardware.mlipay-service.rc \
+    vendor/xiaomi/sm8650-common/proprietary/vendor/etc/init/slad.rc:$(TARGET_COPY_OUT_VENDOR)/etc/init/slad.rc \
+    vendor/xiaomi/sm8650-common/proprietary/vendor/etc/init/vendor.qti.sla.service@1.0-service.rc:$(TARGET_COPY_OUT_VENDOR)/etc/init/vendor.qti.sla.service@1.0-service.rc \
+    vendor/xiaomi/sm8650-common/proprietary/vendor/etc/init/vendor.rongcard.eid@1.0-service.rc:$(TARGET_COPY_OUT_VENDOR)/etc/init/vendor.rongcard.eid@1.0-service.rc \
+    vendor/xiaomi/sm8650-common/proprietary/vendor/etc/sla/slad.conf:$(TARGET_COPY_OUT_VENDOR)/etc/sla/slad.conf \
+    ,$(PRODUCT_COPY_FILES))
 
 # Enable virtual AB with vendor ramdisk
 $(call inherit-product, $(SRC_TARGET_DIR)/product/virtual_ab_ota/vabc_features.mk)
@@ -42,13 +81,13 @@ PRODUCT_AAPT_PREF_CONFIG := xxhdpi
 AB_OTA_POSTINSTALL_CONFIG += \
     RUN_POSTINSTALL_system=true \
     POSTINSTALL_PATH_system=system/bin/otapreopt_script \
-    FILESYSTEM_TYPE_system=ext4 \
+    FILESYSTEM_TYPE_system=erofs \
     POSTINSTALL_OPTIONAL_system=true
 
