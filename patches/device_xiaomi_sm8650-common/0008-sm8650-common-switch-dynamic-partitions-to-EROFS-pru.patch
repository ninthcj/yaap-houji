+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.xiaomi.settings.battery;
+
+import android.app.Fragment;
+import android.os.Bundle;
+
+import com.android.settingslib.collapsingtoolbar.CollapsingToolbarBaseActivity;
+import com.android.settingslib.collapsingtoolbar.R;
+
+public class ChargingControlSettingsActivity extends CollapsingToolbarBaseActivity {
+
+    private static final String TAG = "charging_control";
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+
+        Fragment fragment = getFragmentManager().findFragmentById(R.id.content_frame);
+        if (fragment == null) {
+            getFragmentManager().beginTransaction()
+                    .add(R.id.content_frame, new ChargingControlSettingsFragment(), TAG)
+                    .commit();
+        }
+    }
+}
diff --git a/parts/src/com/xiaomi/settings/battery/ChargingControlSettingsFragment.java b/parts/src/com/xiaomi/settings/battery/ChargingControlSettingsFragment.java
new file mode 100644
index 0000000..930157b
--- /dev/null
+++ b/parts/src/com/xiaomi/settings/battery/ChargingControlSettingsFragment.java
@@ -0,0 +1,85 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.xiaomi.settings.battery;
+
+import android.hardware.health.BatteryChargingPolicy;
+import android.hardware.health.IHealth;
+import android.os.Binder;
+import android.os.Bundle;
+import android.os.IBinder;
+import android.os.ServiceManager;
+import android.util.Log;
+import android.widget.CompoundButton;
+
+import androidx.preference.PreferenceFragment;
+
+import com.android.settingslib.widget.MainSwitchPreference;
+import com.xiaomi.settings.R;
+
+public class ChargingControlSettingsFragment extends PreferenceFragment
+        implements CompoundButton.OnCheckedChangeListener {
+
+    private static final String TAG = "XiaomiPartsChargingControl";
+    private static final String HEALTH_FQNAME = IHealth.DESCRIPTOR + "/default";
+
+    private MainSwitchPreference mSwitchBar;
+    private IHealth mHealthService;
+
+    @Override
+    public void onCreatePreferences(Bundle savedInstanceState, String rootKey) {
+        addPreferencesFromResource(R.xml.settings_charging_control);
+
+        mSwitchBar = (MainSwitchPreference) findPreference("charging_control_enable");
+        if (mSwitchBar != null) {
+            boolean enabled = isLongLifeEnabled();
+            mSwitchBar.setChecked(enabled);
+            mSwitchBar.addOnSwitchChangeListener(this);
+        }
+    }
+
+    @Override
+    public void onCheckedChanged(CompoundButton buttonView, boolean isChecked) {
+        setLongLifeEnabled(isChecked);
+    }
+
+    private IHealth getHealthService() {
+        if (mHealthService == null) {
+            try {
+                IBinder binder = Binder.allowBlocking(
+                        ServiceManager.waitForDeclaredService(HEALTH_FQNAME));
+                if (binder != null) {
+                    mHealthService = IHealth.Stub.asInterface(binder);
+                }
+            } catch (Exception e) {
+                Log.e(TAG, "Failed to bind IHealth service", e);
+            }
+        }
+        return mHealthService;
+    }
+
+    private boolean isLongLifeEnabled() {
+        try {
+            IHealth health = getHealthService();
+            if (health != null) {
+                return health.getChargingPolicy() == BatteryChargingPolicy.LONG_LIFE;
+            }
+        } catch (Exception e) {
+            Log.e(TAG, "Failed to read charging policy", e);
+        }
+        return false;
+    }
+
+    private void setLongLifeEnabled(boolean enable) {
+        try {
+            IHealth health = getHealthService();
+            if (health != null) {
+                health.setChargingPolicy(
+                        enable ? BatteryChargingPolicy.LONG_LIFE : BatteryChargingPolicy.DEFAULT);
+            }
+        } catch (Exception e) {
+            Log.e(TAG, "Failed to set charging policy", e);
+        }
+    }
+}
