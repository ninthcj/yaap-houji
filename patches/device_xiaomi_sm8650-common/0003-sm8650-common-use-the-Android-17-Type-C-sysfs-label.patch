From d835bc2970126cf739a6078a4eb431bc9126d75a Mon Sep 17 00:00:00 2001
From: ninthcj <327845320+ninthcj@users.noreply.github.com>
Date: Mon, 23 Nov 2026 16:49:31 -0400
Subject: [PATCH 3/8] sm8650-common: use the Android 17 Type-C sysfs label

Keep batterysecret directory search limited to the platform sysfs_typec type, matching the Android 17 device reference.
---
 sepolicy/vendor/batterysecret.te | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/sepolicy/vendor/batterysecret.te b/sepolicy/vendor/batterysecret.te
index 2ba9192..90f2123 100644
--- a/sepolicy/vendor/batterysecret.te
+++ b/sepolicy/vendor/batterysecret.te
@@ -13,7 +13,7 @@ allow batterysecret vendor_sysfs_battery_supply:file rw_file_perms;
 allow batterysecret vendor_sysfs_battery_supply:file write;
 allow batterysecret vendor_sysfs_battery_supply:file { open read write };
 allow batterysecret vendor_sysfs_battery_supply:dir r_dir_perms;
-allow batterysecret vendor_sysfs_usb_c:dir { search };
+allow batterysecret sysfs_typec:dir search;
 allow batterysecret system_suspend_server:binder { call transfer };
 allow batterysecret system_suspend_server:fd *;
 allow batterysecret system_suspend_hwservice:hwservice_manager find;
-- 
2.56.1

