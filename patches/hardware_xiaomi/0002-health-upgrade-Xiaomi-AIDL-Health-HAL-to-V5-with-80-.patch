+namespace {
+
+// HealthInfo.aidl mandates capacities in uAh (> 100,000 uAh for real batteries).
+// Legacy Xiaomi kernels reported mAh (< 100,000), whereas SM8650 reports uAh directly.
+constexpr int32_t kChargeCounterMultiplier = 1000;
+constexpr int32_t kMahUpperBound = 100000;
+constexpr int64_t kChargeTimeToFullMultiplier = 60;
+constexpr int64_t kTimeToFullUnsupportedRaw = 65535;
+
+// 80% ceiling matches Android 17 Battery Defender / Longevity threshold;
+// 75% resume provides a 5% hysteresis deadband so PMIC bypass neverchatters.
+constexpr int32_t kLongLifeStopSoc = 80;
+constexpr int32_t kLongLifeResumeSoc = 75;
+
+// Xiaomi PMIC GLink BATT_CHG_PROP_NIGHT_CHARGING (0x38): suspends IBAT while
+// keeping VBUS powering VSYS directly (hardware bypass charging, no USB drop).
+constexpr const char* kNightChargingPath = "/sys/class/qcom-battery/night_charging";
+constexpr const char* kUiSohPath = "/sys/class/qcom-battery/ui_soh";
+constexpr const char* kRawSohPath = "/sys/class/qcom-battery/soh";
+// Stored in /data/property (userdata), never touching the factory persist partition.
+constexpr const char* kPolicyProp = "persist.vendor.charge.policy";
+
+int32_t NormalizeUah(int32_t value) {
+    if (value > 0 && value < kMahUpperBound) {
+        return value * kChargeCounterMultiplier;
+    }
+    return value;
 }
-ndk::ScopedAStatus HealthImpl::getChargeCounterUah(int32_t* out) {
-  *out *= kChargeCounterMultiplier;
-  return ndk::ScopedAStatus::ok();
+
+bool IsValidPolicy(BatteryChargingPolicy policy) {
+    switch (policy) {
+        case BatteryChargingPolicy::DEFAULT:
+        case BatteryChargingPolicy::LONG_LIFE:
+        case BatteryChargingPolicy::ADAPTIVE:
+        case BatteryChargingPolicy::FORCE_FULL_CHARGE:
+            return true;
+        default:
+            return false;
+    }
 }
+
+int64_t ReadSohPercent() {
+    for (const char* path : {kUiSohPath, kRawSohPath}) {
+        std::string content;
+        if (::android::base::ReadFileToString(path, &content)) {
+            int64_t soh = 0;
+            if (::android::base::ParseInt(::android::base::Trim(content), &soh) &&
+                soh > 0 && soh <= 100) {
+                return soh;
+            }
+        }
+    }
+    return 0;
+}
+
+BatteryChargingPolicy ReadCurrentPolicy() {
+#ifdef __ANDROID_RECOVERY__
+    return BatteryChargingPolicy::DEFAULT;
+#else
+    int raw = ::android::base::GetIntProperty(
+        kPolicyProp, static_cast<int>(BatteryChargingPolicy::DEFAULT));
+    auto policy = static_cast<BatteryChargingPolicy>(raw);
+    return IsValidPolicy(policy) ? policy : BatteryChargingPolicy::DEFAULT;
+#endif
+}
+
+}  // namespace
+
+class HealthImpl : public Health {
+  public:
+    using Health::Health;
+    ~HealthImpl() override = default;
+
+    ndk::ScopedAStatus getChargeCounterUah(int32_t* out) override {
+        auto status = Health::getChargeCounterUah(out);
+        if (status.isOk() && out != nullptr) {
+            *out = NormalizeUah(*out);
+        }
+        return status;
+    }
+
+    ndk::ScopedAStatus getBatteryHealthData(BatteryHealthData* out) override {
+        auto status = Health::getBatteryHealthData(out);
+        if (status.isOk() && out != nullptr && out->batteryStateOfHealth <= 0) {
+            int64_t soh = ReadSohPercent();
+            if (soh > 0) {
+                out->batteryStateOfHealth = soh;
+            }
+        }
+        return status;
+    }
+
+    ndk::ScopedAStatus getChargingPolicy(BatteryChargingPolicy* out) override {
+        if (out == nullptr) {
+            return ndk::ScopedAStatus::fromExceptionCode(EX_NULL_POINTER);
+        }
+        *out = ReadCurrentPolicy();
+        return ndk::ScopedAStatus::ok();
+    }
+
+    ndk::ScopedAStatus setChargingPolicy(BatteryChargingPolicy in_value) override {
+#ifdef __ANDROID_RECOVERY__
+        (void)in_value;
+        return ndk::ScopedAStatus::fromExceptionCode(EX_UNSUPPORTED_OPERATION);
+#else
+        if (!IsValidPolicy(in_value)) {
+            return ndk::ScopedAStatus::fromExceptionCode(EX_ILLEGAL_ARGUMENT);
+        }
+        if (!::android::base::SetProperty(kPolicyProp,
+                                          std::to_string(static_cast<int>(in_value)))) {
+            LOG(ERROR) << "Failed to set " << kPolicyProp;
+            return ndk::ScopedAStatus::fromServiceSpecificError(IHealth::STATUS_UNKNOWN);
+        }
+        {
+            std::lock_guard<std::mutex> lock(policy_mutex_);
+            bypass_synced_ = false;
+        }
+        (void)update();
+        return ndk::ScopedAStatus::ok();
+#endif
+    }
+
+  protected:
+    void UpdateHealthInfo(HealthInfo* health_info) override {
+        if (health_info == nullptr) {
+            return;
+        }
+        if (health_info->batteryChargeTimeToFullNowSeconds == kTimeToFullUnsupportedRaw ||
+            health_info->batteryChargeTimeToFullNowSeconds < 0) {
+            health_info->batteryChargeTimeToFullNowSeconds =
+                HealthInfo::BATTERY_CHARGE_TIME_TO_FULL_NOW_SECONDS_UNSUPPORTED;
+        } else if (health_info->batteryCapacityLevel == BatteryCapacityLevel::FULL ||
+                   health_info->batteryCapacityLevel == BatteryCapacityLevel::UNKNOWN) {
+            health_info->batteryChargeTimeToFullNowSeconds = 0;
+        } else {
+            health_info->batteryChargeTimeToFullNowSeconds *= kChargeTimeToFullMultiplier;
+        }
+
+        health_info->batteryChargeCounterUah = NormalizeUah(health_info->batteryChargeCounterUah);
+        health_info->batteryFullChargeUah = NormalizeUah(health_info->batteryFullChargeUah);
+        health_info->batteryFullChargeDesignCapacityUah =
+            NormalizeUah(health_info->batteryFullChargeDesignCapacityUah);
+
+        if (health_info->batteryFullChargeUah <= 0 &&
+            health_info->batteryFullChargeDesignCapacityUah > 0) {
+            int64_t soh = ReadSohPercent();
+            if (soh > 0) {
+                health_info->batteryFullChargeUah = static_cast<int32_t>(
+                    (static_cast<int64_t>(health_info->batteryFullChargeDesignCapacityUah) * soh) /
+                    100);
+            }
+        }
+
+#ifndef __ANDROID_RECOVERY__
+        std::lock_guard<std::mutex> lock(policy_mutex_);
+        ApplyChargingPolicyLocked(health_info, ReadCurrentPolicy());
+#endif
+    }
+
+  private:
+    void SetNightChargingLocked(bool enable) {
+        if (bypass_synced_ && bypass_active_ == enable) {
+            return;
+        }
+        if (::android::base::WriteStringToFile(enable ? "1" : "0", kNightChargingPath, true)) {
+            bypass_active_ = enable;
+            bypass_synced_ = true;
+        } else {
+            LOG(WARNING) << "Failed to write night_charging=" << (enable ? 1 : 0);
+        }
+    }
+
+    void ApplyChargingPolicyLocked(HealthInfo* info, BatteryChargingPolicy policy) {
+        const bool charger_online = info->chargerAcOnline || info->chargerUsbOnline ||
+                                    info->chargerWirelessOnline || info->chargerDockOnline;
+        bool want_bypass = bypass_active_;
+        if (policy != BatteryChargingPolicy::LONG_LIFE || !charger_online) {
+            want_bypass = false;
+        } else if (info->batteryLevel >= kLongLifeStopSoc) {
+            want_bypass = true;
+        } else if (info->batteryLevel <= kLongLifeResumeSoc) {
+            want_bypass = false;
+        }
+        SetNightChargingLocked(want_bypass);
+
+        info->chargingPolicy = policy;
+        if (policy == BatteryChargingPolicy::LONG_LIFE && charger_online && bypass_active_) {
+            info->chargingState = BatteryChargingState::LONG_LIFE;
+        } else if (policy == BatteryChargingPolicy::ADAPTIVE && charger_online) {
+            info->chargingState = BatteryChargingState::ADAPTIVE;
+        } else if (info->chargingState == BatteryChargingState::INVALID) {
+            info->chargingState = BatteryChargingState::NORMAL;
+        }
+    }
+
+    std::mutex policy_mutex_;
+    bool bypass_active_ = false;
+    bool bypass_synced_ = false;
+};
+
 }  // namespace aidl::android::hardware::health
 
