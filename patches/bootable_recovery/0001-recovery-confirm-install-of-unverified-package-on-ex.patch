+      return INSTALL_CORRUPT;
+    }
+    LOG(WARNING) << "Installing package that failed signature verification at user request";
+    ui->Print("Installing untrusted package at your request.\n");
   }
 
   // Verify and install the contents of the package.
@@ -628,7 +657,8 @@ static InstallResult VerifyAndInstallPackage(Package* package, bool* wipe_cache,
 }
 
