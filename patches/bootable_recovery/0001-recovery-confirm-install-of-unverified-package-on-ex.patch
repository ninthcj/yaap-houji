+// An explicitly unlocked device (ro.boot.flash.locked == 0) may install a package that fails
+// signature verification, but only when a person on a visible screen picks "Yes". Anything else
+// (locked, property absent, hidden or no UI, key interruption) keeps the package rejected.
+static bool ConfirmUntrustedInstall(Device* device) {
+  if (android::base::GetProperty("ro.boot.flash.locked", "") != "0") {
+    return false;
+  }
+  auto ui = device->GetUI();
+  if (!ui->IsTextVisible()) {
+    return false;
+  }
+  const std::vector<std::string> headers{ "Signature verification failed",
+                                          "Install untrusted package?" };
+  const std::vector<std::string> items{ "No", "Yes" };
+  constexpr size_t kNo = 0;
+  constexpr size_t kYes = 1;
+  size_t chosen = ui->ShowMenu(
+      headers, items, kNo, true,
+      std::bind(&Device::HandleMenuKey, device, std::placeholders::_1, std::placeholders::_2));
+  return chosen == kYes;
+}
